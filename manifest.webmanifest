{
  "name": "Hub — Saathvik's command center",
  "short_name": "Hub",
  "description": "Mail, calendar, tasks, notes, GitHub and portfolio in one place.",
  "id": "./",
  "start_url": "./#/today",
  "scope": "./",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "orientation": "any",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Mail", "url": "./#/mail", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Calendar", "url": "./#/calendar", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tasks", "url": "./#/tasks", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Notes", "url": "./#/notes", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
